<MBeanType
 Name          = "CustomInboundAuthenticator"
 Package       = "org.falpi.osb.security.providers"
 Extends       = "weblogic.management.security.authentication.IdentityAsserter"
 PersistPolicy = "OnUpdate"
>

   <MBeanAttribute
  Name          = "ProviderClassName"
  Type          = "java.lang.String"
  Preprocessor  = "weblogic.management.configuration.LegalHelper.checkClassName(value)"
  Default       = "&quot;org.falpi.osb.security.providers.CustomInboundAuthenticator&quot;"
  Writeable     = "false"
 />

   <MBeanAttribute
  Name          = "Description"
  Type          = "java.lang.String"
  Default       = "&quot;Custom Inbound Authenticator&quot;"
  Writeable     = "false"
 />

   <MBeanAttribute
  Name          = "Version"
  Type          = "java.lang.String"
  Default       = "&quot;1.0.0&quot;"   
  Writeable     = "false"
 />

   <MBeanAttribute  
  Name 		= "SupportedTypes"
  Type 		= "java.lang.String[]"
  Writeable 	= "false"
  Default 	= "new String[] {
     &quot;CIA.BASIC&quot;,
     &quot;CIA.JWT&quot;,
     &quot;CIA.JWT#1&quot;,
     &quot;CIA.JWT#2&quot;,
     &quot;CIA.JWT+BASIC&quot;,
     &quot;CIA.JWT+BASIC#1&quot;,
     &quot;CIA.JWT+BASIC#2&quot; 
  }"                  
 />

   <MBeanAttribute  
  Name 		= "ActiveTypes"
  Type 		= "java.lang.String[]"
  Default 	= "new String[] {}"
 />

   <MBeanAttribute  
  Name 		= "Base64DecodingRequired"
  Type 		= "boolean"
  Default 	= "false"
  Writeable 	= "true"
 />
 
    <MBeanAttribute  
  Name 		= "PROVIDER_TYPE"
  Type 		= "java.lang.String"
  LegalValues   = "INBOUND" 
  Default 	= "&quot;INBOUND&quot;"
  Description   = "Provider type"
  Writeable 	= "true"
  Dynamic       = "true"
 />

    <MBeanAttribute  
  Name 		= "LOGGING_LINES"
  Type 		= "java.lang.Integer"
  Default 	= "10"
  Description   = "Maximum stacktrace rows to be logged"
  Writeable 	= "true"
  Dynamic       = "true"
 />

    <MBeanAttribute  
  Name 		= "LOGGING_LEVEL"
  Type 		= "java.lang.String"
  LegalValues   = "TRACE,DEBUG,INFO,WARN,ERROR" 
  Default 	= "&quot;INFO&quot;"
  Description   = "Minimum level of log messages that end up in the logging file"
  Writeable 	= "true"
  Dynamic       = "true"
 />

    <MBeanAttribute  
  Name 		= "LOGGING_INFO"
  Type 		= "java.lang.String"
  Default 	= "&quot;Service: ${osb.service.name}, Identity: ${identity}, Client: ${http.client.host} (${http.client.addr})&quot;"
  Description   = "Details logged at the conclusion of each request"
  Writeable 	= "true"
  Dynamic       = "true"
 />

    <MBeanAttribute  
  Name 		= "THREADING_MODE"
  Type 		= "java.lang.String"
  LegalValues   = "SERIAL,PARALLEL" 
  Default 	= "&quot;PARALLEL&quot;"
  Description   = "Enable/Disable requests parallelism"
  Writeable 	= "true"
  Dynamic       = "true"
 />
  
    <MBeanAttribute  
  Name 		= "REQUESTS_SSL_VERIFY"
  Type 		= "java.lang.String"
  LegalValues   = "ENABLE,DISABLE" 
  Default 	= "&quot;ENABLE&quot;"
  Description   = "Http requests SSL enforcement"
  Writeable 	= "true"
  Dynamic       = "true"
 />
 
    <MBeanAttribute  
  Name 		= "REQUESTS_CONN_TIMEOUT"
  Type 		= "java.lang.String"
  LegalValues   = "0,5,10,15,20,25,30"
  Default 	= "&quot;5&quot;"
  Description   = "Http requests connection timeout (Seconds)"
  LegalNull     = "false"
  Writeable 	= "true"
  Dynamic       = "true"
 />

    <MBeanAttribute  
  Name 		= "REQUESTS_READ_TIMEOUT"
  Type 		= "java.lang.String"
  LegalValues   = "0,5,10,15,20,25,30"
  Default 	= "&quot;5&quot;"
  Description   = "Http requests response timeout (Seconds)"
  Writeable 	= "true"
  Dynamic       = "true"
 />
  
    <MBeanAttribute  
  Name 		= "REQUESTS_PROXY_MODE"
  Type 		= "java.lang.String"
  LegalValues   = "DIRECT,ANONYMOUS,BASIC,NTLM,KERBEROS" 
  Default 	= "&quot;DIRECT&quot;"
  Description   = "Http requests require proxy mediation"
  Writeable 	= "true"
  Dynamic       = "true"
 />
 
    <MBeanAttribute  
  Name 		= "REQUESTS_PROXY_PATH"   
  Type 		= "java.lang.String"
  Description   = "OSB path for the proxy server"
  Writeable 	= "true"
  Dynamic       = "true"
 />

    <MBeanAttribute  
  Name 		= "BASIC_AUTH"
  Type 		= "java.lang.String"
  LegalValues   = "ENABLE,DISABLE" 
  Default 	= "&quot;DISABLE&quot;"
  Description   = "Allows to control Basic authentication"
  Writeable 	= "true"
  Dynamic       = "true"
 />  
 
    <MBeanAttribute  
  Name 		= "JWT_AUTH"
  Type 		= "java.lang.String"
  LegalValues   = "ENABLE,DISABLE" 
  Default 	= "&quot;DISABLE&quot;"
  Description   = "Allows to control JWT authentication"
  Writeable 	= "true"
  Dynamic       = "true"
 />  
 
    <MBeanAttribute  
  Name 		= "JWT_POLICIES_PATH"
  Type 		= "java.lang.String"
  Description   = "OSB path for the inbound security policies XML"
  Writeable 	= "true"
  Dynamic       = "true"
 />
 
    <MBeanAttribute  
  Name 		= "JWT_RESOURCE_MAPPING_PATH"
  Type 		= "java.lang.String"
  Description   = "OSB mapping service account used to translate resource identifiers"
  Writeable 	= "true"
  Dynamic       = "true"
 />  

    <MBeanAttribute  
  Name 		= "CUSTOM_REQUEST_HEADERS"
  Type 		= "java.util.Properties"
  Description   = "Each line is treated as a custom http request header"
  Writeable 	= "true"
  Dynamic       = "true"
 />

    <MBeanAttribute  
  Name 		= "CUSTOM_RESPONSE_HEADERS"
  Type 		= "java.util.Properties"
  Description   = "Each line is treated as a custom http response header"
  Writeable 	= "true"
  Dynamic       = "true"
 /> 
 
    <MBeanAttribute  
  Name 		= "DEBUGGING_ASSERTION"
  Type 		= "java.lang.String[]"
  Description   = "Logging filter assertion (javascript returning boolean)"
  Writeable 	= "true"
  Dynamic       = "true"
 /> 
 
    <MBeanAttribute  
  Name 		= "DEBUGGING_PROPERTIES"
  Type 		= "java.lang.String[]"
  Description   = "Properties/espressions to be logged"
  Writeable 	= "true"
  Dynamic       = "true"
 />
  
    <MBeanAttribute  
  Name 		= "KERBEROS_CONFIGURATION"
  Type 		= "java.lang.String[]"
  Description   = "Configuration for kerberos authentication"
  Writeable 	= "true"
  Dynamic       = "true"
 />

</MBeanType>
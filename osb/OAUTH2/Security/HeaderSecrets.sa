<?xml version="1.0" encoding="UTF-8"?>
<ser:service-account xsi:type="ser:MappedServiceAccount" xmlns:ser="http://www.bea.com/wli/sb/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <ser:properties>
        <ser:caching enabled="true" max-size="512" cache-ttl="300000"/>
        <ser:precedence-rules>roles-before-groups</ser:precedence-rules>
    </ser:properties>
    <ser:remote-user-table>
        <ser:remote-user>
            <con:username>anonymous</con:username>
            <con:password>ANY-VALUE</con:password>
        </ser:remote-user>
        <ser:remote-user>
            <con:username>BS_Orders_1.0-createOrder</con:username>
            <con:password>HEADER-VALUE</con:password>
        </ser:remote-user>
        <ser:remote-user>
            <con:username>BS_Orders_1.0-cancelOrder</con:username>
            <con:password>HEADER-VALUE</con:password>
        </ser:remote-user>
        <ser:remote-user>
            <con:username>BS_Payments_1.0-notifyPayment</con:username>
            <con:password>HEADER-VALUE</con:password>
        </ser:remote-user>
    </ser:remote-user-table>
    <ser:user-mappings/>
    <ser:anonymous-mapping username="anonymous"/>
</ser:service-account>